[{"id":"p.s-not-structure","type":"proposition","name":"S 是显露不是结构","aliases":[],"def":"S 指结构的显露连续谱,不等于传统静态'结构';问'哪些条件让它显露成现在这样'。","links":{"concept":["c.show"]},"seed":"canon","sources":[],"docfreq":0},{"id":"p.d-not-change","type":"proposition","name":"D 不是变化","aliases":[],"def":"变化是表象;D 关心何种差异能推进/被抑制/放大/收敛成结构。","links":{"concept":["c.difference-seq"]},"seed":"canon","sources":[],"docfreq":0},{"id":"p.e-not-background","type":"proposition","name":"E 不是背景","aliases":[],"def":"背景被动可忽略;E 是主动参与生成的发生土壤,没有它对象不发生。","links":{"concept":["c.entanglement"]},"seed":"canon","sources":[572,1122,1123],"docfreq":3},{"id":"p.mature-not-primal","type":"proposition","name":"完整 SDE 是成熟态不是原初态","aliases":[],"def":"三方程严格成立处是三维长齐互相咬合的成熟态;现实对象多是它不同步时刻的变形侧影。","links":{"concept":["c.mature-state"],"theory":["t.three-eq"]},"seed":"canon","sources":[],"docfreq":0},{"id":"p.contradiction-is-engine","type":"proposition","name":"矛盾是引擎不是故障","aliases":[],"def":"D 与 E 的矛盾是机器唯一动力源;看到张力不是系统坏了,是它正要发生什么。","links":{"theory":["t.123"]},"seed":"canon","sources":[272,1113],"docfreq":2},{"id":"p.writeback-half-loop","type":"proposition","name":"漏掉回写就只用了半个123","aliases":[],"def":"③新 S 回写 D-E 是最易漏的一笔;走到②就停=单程一次性,不是循环自我推进。","links":{"concept":["c.writeback"],"theory":["t.123"]},"seed":"canon","sources":[],"docfreq":0},{"id":"p.rigor-is-unreach","type":"proposition","name":"经得起反驳的判断=单视角不可达","aliases":[],"def":"不是'全面'而是任何单一视角都给不出、三视角误差互消后才浮现的凝缩。","links":{"concept":["c.single-view-unreach"]},"seed":"canon","sources":[],"docfreq":0},{"id":"p.start-wrong-waste","type":"proposition","name":"起点错了后面再深也是浪费","aliases":[],"def":"起点决定把哪一维当'被解释项';起点错=写出每句都对合起来没用的东西。","links":{"concept":["c.six-paths"]},"seed":"canon","sources":[],"docfreq":0},{"id":"p.three-realm-dislocation","type":"proposition","name":"三界错位是危机的根本","aliases":[],"def":"理念界期待与现实界处境错位、自我界在拉扯中撕裂——多数'困境'的实质。","links":{"concept":["c.three-realms"]},"seed":"canon","sources":[],"docfreq":0},{"id":"p.d3-over-d1","type":"proposition","name":"D3 压过 D1 = 高效而贫血","aliases":[],"def":"过度优化使有方向的演化退化为无意义的效率;当代 KPI/绩效主义的根本病理。","links":{"concept":["c.d3-optimize"]},"seed":"canon","sources":[],"docfreq":0},{"id":"p.info-not-knowledge","type":"proposition","name":"信息发生≠知识发生","aliases":[],"def":"大模型 E2 强 E1 空 E3 无,产信息不产知识;架构级缺陷,规模不消除。","links":{"concept":["c.info-vs-knowledge"],"controversy":["x.llm-diagnosis"]},"seed":"canon","sources":[0,194,369,432,444,1123],"docfreq":6},{"id":"p.universal-holographic","type":"proposition","name":"普适不来自空洞而来自全息","aliases":[],"def":"靠'抽象到什么都能套'求普适=什么也没说;123 的普适来自每层递归重现、可具体指认地用上。","links":{"concept":["c.holography-123"]},"seed":"canon","sources":[],"docfreq":0},{"id":"p.rename-not-swap","type":"proposition","name":"改姓≠换术语","aliases":[],"def":"换词只是最浅一层;改姓是术语/句法/论证节奏/本体论假设四层,让本地读者获 SDE 深度却不知其来源。","links":{"concept":["c.rename-claw"],"theory":["t.forging-laws"]},"seed":"canon","sources":[],"docfreq":0},{"id":"p.marriage-crisis","type":"proposition","name":"婚姻危机不是没人愿结婚","aliases":[],"def":"是制度已不知在功能解耦后还有什么必须被保护的核心;从全功能制度沉默跃迁为纯法律壳。","links":{"case":["case.marriage"]},"seed":"canon","sources":[],"docfreq":0},{"id":"p.geometry-battlefield","type":"proposition","name":"数学教育战场在评价系统不在教室","aliases":[],"def":"任何忽视评价系统纠缠厚度的教学改革,都被现实场域引力压回原位。","links":{"case":["case.geometry"]},"seed":"canon","sources":[],"docfreq":0},{"id":"p.no-seventh-path","type":"proposition","name":"恰好六路径没有第七条","aliases":[],"def":"3!=6 是硬约束,逼你必须选起点而不许含糊'综合地看';觉得哪条都不像=任务DNA没认准。","links":{"concept":["c.six-paths"],"theory":["t.six-paths"]},"seed":"canon","sources":[],"docfreq":0}]